# Docker 部署环境变量（复制为 .env 后修改）

# 生成示例：
#   openssl rand -hex 32

# API 鉴权 token（必填）：后端全部 /api/v1 路由要求 Authorization: Bearer <token>
# 前端同源部署无需配置；外部脚本/客户端调用 API 时必须携带
FUSION_API_TOKEN=please-change-me

# Watchtower HTTP API 令牌（必填）：app 与 watchtower 两侧必须一致；生产环境务必修改
WATCHTOWER_TOKEN=please-change-me

# 构建镜像时注入的版本号（发布时指定，如 1.2.0；本地构建保持 dev 即可）
FUSION_VERSION=dev
